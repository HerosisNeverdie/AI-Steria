# ============================================================
# AI薇Steria 环境变量示例
# 用法：复制此文件为 .env，填入真实值，然后 npm start
#   PowerShell:  Copy-Item .env.example .env
# .env 已被 .gitignore 忽略，不会上传到 GitHub。
# ============================================================

# 服务监听端口
PORT=8787

# ---- 模型提供方 ----
# 可选值：deepseek | openai | mock
# mock = 本地假回复，不需要任何 API Key，用来先跑通界面
PROVIDER=mock

# DeepSeek（https://platform.deepseek.com）
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat

# OpenAI 或任意 OpenAI 兼容网关（如本地 Ollama / vLLM / OneAPI）
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# 自建兼容网关时改这里，例如 http://localhost:11434/v1
OPENAI_BASE_URL=https://api.openai.com/v1

# 助手人设
SYSTEM_PROMPT=你是 AI薇Steria，一个友好、简洁、乐于助人的中文 AI 助手。

# 单次回复最大 token
MAX_TOKENS=2048
